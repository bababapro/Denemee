local function LoadModule(ModuleName)
    local URL = string.format("https://raw.githubusercontent.com/%s/%s/%s/Modules/%s.lua?t=%s", User, Repo, Branch, ModuleName, tick())
    local success, code = pcall(function() return game:HttpGet(URL) end)
    if success and code then
        local func = loadstring(code)
        if func then return func() end
    end
    return nil
end

local KryvexModules = {
    { name = "KryvexCombat",   run = function() KryvexCombat.Init(CombatTab) end },
    { name = "KryvexESP",      run = function() KryvexESP.Init(ESPTab) end },
    { name = "KryvexMovement", run = function() KryvexMovement.Init(MovementTab) end },
    { name = "KryvexTroll",    run = function() KryvexTroll.Init(TrollTab) end },
    { name = "Home",           run = function(m) if m and m.Init then m.Init(HomeTab, Library) end end },
    { name = "Player",         run = function(m) if m and m.Init then m.Init(PlayerTab) end end },
    { name = "Teleport",       run = function(m) if m and m.Init then m.Init(TeleportTab) end end },
    { name = "World",          run = function(m) if m and m.Init then m.Init(WorldTab, Library) end end },
    { name = "Settings",       run = function(m) if m and m.Init then m.Init(SettingsTab, HubWindow, {User = User, Repo = Repo, Branch = Branch}, Config) end end },
    { name = "Protection",     run = function(m) if m and m.Init then m.Init(ProtectionTab) end end },
    { name = "Vehicle",        run = function(m) if m and m.Init then m.Init(VehicleTab) end end },
    { name = "Build",          run = function(m) if m and m.Init then m.Init(BuildTab) end end },
    { name = "Shop",           run = function(m) if m and m.Init then m.Init(ShopTab) end end },
    { name = "Duplication",    run = function(m) if m and m.Init then m.Init(DuplicationTab) end end },
    { name = "Tool",           run = function(m) if m and m.Init then m.Init(ToolTab) end end },
}

local total = #KryvexModules
for i, entry in ipairs(KryvexModules) do
    SetProgress(i - 1, total, entry.name)
    local moduleFinished = false
    local skipRequested  = false
    local skipConn
    skipConn = SkipButton.MouseButton1Click:Connect(function()
        skipRequested = true
        warn("[Kryvex Loader] Atlanıyor: " .. entry.name)
    end)
    task.delay(5, function()
        if not moduleFinished then
            WarningLabel.Visible = true
            SkipButton.Visible   = true
        end
    end)
    task.spawn(function()
        local ok, err = pcall(function()
            if entry.name:find("^Kryvex") then
                entry.run()
            else
                local m = LoadModule(entry.name)
                entry.run(m)
            end
        end)
        moduleFinished = true
        if not ok then warn("[Kryvex Loader] " .. entry.name .. " başarısız: " .. tostring(err)) end
    end)
    repeat task.wait() until moduleFinished or skipRequested
    if skipConn then skipConn:Disconnect() end
    WarningLabel.Visible = false
    SkipButton.Visible   = false
    task.wait(0.05)
end

SetProgress(total, total, nil)
task.wait(0.4)
DismissLoadScreen()
Library:Notify("Kryvex Hub", "Tüm modüller yüklendi! 🎉", 5)
