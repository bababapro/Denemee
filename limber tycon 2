    end)
    
    tab:CreateButton("Kill All", "Kill All", function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health = 0 end
            end
        end
        Library:Notify("Kryvex Troll", "Herkes öldürüldü!", 3)
    end)
    
    tab:CreateSection("Fun")
    tab:CreateButton("Rainbow Character", "Rainbow", function()
        _G.KryvexRainbowChar = not _G.KryvexRainbowChar
    end)
    
    RunService.Heartbeat:Connect(function()
        if not _G.KryvexRainbowChar then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hue = (os.clock() * 0.5) % 1
        local color = Color3.fromHSV(hue, 1, 1)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.Color = color end
        end
    end)
end

