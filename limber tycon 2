local KryvexESP = {}
function KryvexESP.Init(tab)
    local espEnabled = false
    local espNames = true
    local espHealth = true
    local espDistance = true
    local espMaxDist = 1500
    local espColor = Color3.fromRGB(220, 38, 38)
    local rainbowEsp = false
    
    local espOverlay = Instance.new("ScreenGui")
    espOverlay.Name = "KryvexESP"
    espOverlay.ResetOnSpawn = false
    espOverlay.IgnoreGuiInset = true
    espOverlay.Parent = CoreGui
    
    local drawings = {}
    
    local function createESP(player)
        if drawings[player] then return end
        if player == LocalPlayer then return end
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "KryvexESP_" .. player.Name
        billboard.Size = UDim2.new(0, 200, 0, 60)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = espOverlay
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0, 18)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = player.Name
        nameLabel.TextColor3 = espColor
        nameLabel.TextStrokeTransparency = 0.3
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 14
        nameLabel.Parent = billboard
        local healthBar = Instance.new("Frame")
        healthBar.Size = UDim2.new(0, 80, 0, 4)
        healthBar.Position = UDim2.new(0.5, -40, 0, 20)
        healthBar.BackgroundColor3 = Color3.fromRGB(30, 10, 10)
        healthBar.BorderSizePixel = 0
        healthBar.Parent = billboard
        local corner = Instance.new("UICorner", healthBar)
        corner.CornerRadius = UDim.new(0, 2)
        local healthFill = Instance.new("Frame")
        healthFill.Size = UDim2.new(1, 0, 1, 0)
        healthFill.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
        healthFill.BorderSizePixel = 0
        healthFill.Parent = healthBar
        local corner2 = Instance.new("UICorner", healthFill)
        corner2.CornerRadius = UDim.new(0, 2)
        local distLabel = Instance.new("TextLabel")
        distLabel.Size = UDim2.new(1, 0, 0, 14)
        distLabel.Position = UDim2.new(0, 0, 0, 26)
        distLabel.BackgroundTransparency = 1
        distLabel.Text = "0 studs"
        distLabel.TextColor3 = Color3.fromRGB(200, 150, 150)
        distLabel.Font = Enum.Font.Gotham
        distLabel.TextSize = 11
        distLabel.Parent = billboard
        local highlight = Instance.new("Highlight")
        highlight.Name = "KryvexHighlight"
        highlight.FillColor = espColor
        highlight.OutlineColor = espColor
        highlight.FillTransparency = 0.7
        highlight.OutlineTransparency = 0.2
        highlight.Parent = espOverlay
        drawings[player] = {billboard = billboard, nameLabel = nameLabel, healthBar = healthBar, healthFill = healthFill, distLabel = distLabel, highlight = highlight}
    end
    
    local function removeESP(player)
        local d = drawings[player]
        if not d then return end
        d.billboard:Destroy()
        d.highlight:Destroy()
        drawings[player] = nil
    end
    
    tab:CreateSection("ESP Settings")
    tab:CreateToggle("Enable ESP", false, function(state)
        espEnabled = state
        if not state then for player in pairs(drawings) do removeESP(player) end end
    end)
    tab:CreateToggle("Show Names", true, function(state) espNames = state end)
    tab:CreateToggle("Show Health", true, function(state) espHealth = state end)
    tab:CreateToggle("Show Distance", true, function(state) espDistance = state end)
    tab:CreateToggle("Rainbow ESP", false, function(state) rainbowEsp = state end)
    tab:CreateSlider("Max Distance", 100, 5000, 1500, function(value) espMaxDist = value end)
    
    RunService.RenderStepped:Connect(function()
        if not espEnabled then
            for player in pairs(drawings) do removeESP(player) end
            return
        end
        local camera = workspace.CurrentCamera
        if not camera then return end
        local hue = (os.clock() * 0.3) % 1
        local currentColor = rainbowEsp and Color3.fromHSV(hue, 0.9, 1) or espColor
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                if hrp and humanoid and humanoid.Health > 0 then
                    local dist = (hrp.Position - camera.CFrame.Position).Magnitude
                    if dist <= espMaxDist then
                        createESP(player)
                        local d = drawings[player]
                        if d then
                            d.billboard.Adornee = hrp
                            d.billboard.Enabled = true
                            d.nameLabel.Text = player.Name
                            d.nameLabel.Visible = espNames
                            d.nameLabel.TextColor3 = currentColor
                            d.healthBar.Visible = espHealth
                            d.healthFill.Size = UDim2.new(math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1), 0, 1, 0)
                            d.distLabel.Text = math.floor(dist) .. " studs"
                            d.distLabel.Visible = espDistance
                            d.highlight.Adornee = player.Character
                            d.highlight.FillColor = currentColor
                            d.highlight.OutlineColor = currentColor
                            d.highlight.Enabled = true
                        end
                    else
                        removeESP(player)
                    end
                else
                    removeESP(player)
                end
            end
        end
    end)
    Players.PlayerRemoving:Connect(removeESP)
end

