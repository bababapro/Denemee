BASE85_ALPHABET = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!#$%&()*+-;<=>?@^_`{|}~"

def base85_encode(data: bytes) -> str:
    result = []
    for i in range(0, len(data), 4):
        chunk = data[i:i+4]
        if len(chunk) < 4:
            chunk = chunk + b"\x00" * (4 - len(chunk))
        value = int.from_bytes(chunk, "big")
        encoded = []
        for _ in range(5):
            encoded.append(BASE85_ALPHABET[value % 85])
            value //= 85
        result.append("".join(reversed(encoded)))
    return "".join(result)

def base85_decode_lua(name: str) -> str:
