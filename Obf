local A="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!#$%&()*+-;<=>?@^_`{{|}}~"
local function idx(c)return (A:find(c,1,true)or 1)-1 end
local out={{}}
for i=1,#s,5 do
local v=0
for j=0,4 do
local ch=s:sub(i+j,i+j)
if ch~="" then v=v*85+idx(ch) end
end
local b1=math.floor(v/16777216)%256
local b2=math.floor(v/65536)%256
local b3=math.floor(v/256)%256
local b4=v%256
table.insert(out,string.char(b1,b2,b3,b4))
end
return table.concat(out):gsub("%z+$","")
end
"""

