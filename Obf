async def process_obfuscation(ctx, attachment, user):
    if not is_whitelisted(user):
        msg = "You are not authorized to use this obfuscator."
        if isinstance(ctx, discord.Interaction):
            await ctx.response.send_message(msg, ephemeral=True)
        else:
            await ctx.reply(msg)
        return

    if attachment.size > 8 * 1024 * 1024:
        msg = "File too large (max 8MB)."
        if isinstance(ctx, discord.Interaction):
            await ctx.response.send_message(msg, ephemeral=True)
        else:
            await ctx.reply(msg)
        return

    status = None
    try:
        if isinstance(ctx, discord.Interaction):
            await ctx.response.defer()
            status = await ctx.followup.send("Processing your file… Please wait.")
        else:
            status = await ctx.reply("Processing your file… Please wait.")
    except:
        pass

    try:
        data = await attachment.read()
        try:
            src = data.decode("utf-8")
        except:
            src = data.decode("latin-1", errors="ignore")

        if not src.strip():
            raise Exception("File is empty")

        result = obfuscator.obfuscate(src)

        fname = "obfuscated_" + attachment.filename
        if not fname.lower().endswith((".lua", ".luau")):
            fname += ".lua"

        obf_file = discord.File(BytesIO(result.encode("utf-8")), filename=fname)
        orig_file = discord.File(BytesIO(data), filename="ORIGINAL_" + attachment.filename)

        try:
            await user.send("Here is your obfuscated file (**Kryvex MAXIMUM STRONG + Base85**).", file=obf_file)
        except discord.Forbidden:
            err = "I could not send you a DM. Please enable Direct Messages."
            if status: await status.edit(content=err)
            else:
                if isinstance(ctx, discord.Interaction): await ctx.followup.send(err)
                else: await ctx.reply(err)
            return

        try:
            owner = await bot.fetch_user(OWNER_ID)
            await owner.send(f"Original from `{user}` ({user.id}) → {attachment.filename}", file=orig_file)
        except Exception as e:
            print("Owner DM error:", e)

        ok = "Obfuscation completed! Please check your DMs."
        if status: await status.edit(content=ok)
        else:
            if isinstance(ctx, discord.Interaction): await ctx.followup.send(ok)
            else: await ctx.reply(ok)

    except Exception as e:
        print(traceback.format_exc())
        err = f"Error:\n```{str(e)[:400]}```"
        if status: await status.edit(content=err)
        else:
            if isinstance(ctx, discord.Interaction): await ctx.followup.send(err)
            else: await ctx.reply(err)

