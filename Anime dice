local function doRoll()
    if not APIs.RollDice then return end
    pcall(function() APIs.RollDice:InvokeServer() end)
    Stats.rolled = (Stats.rolled or 0) + 1
    sendWebhook("Roll", "Dice rolled!")
end

local function doCollect()
    local data = getData()
    if not data then return end
    if APIs.CollectBalance then
        for k in pairs(data.Slots) do
            pcall(function() APIs.CollectBalance:FireServer(tonumber(k)) end)
        end
    end
    if APIs.EquipBest then pcall(function() APIs.EquipBest:FireServer() end) end
end

local function doRebirth()
    if not APIs.Rebirth then return end
    pcall(function() APIs.Rebirth:FireServer() end)
    sendWebhook("Rebirth", "Rebirth complete!")
end

local function doSell()
    if not APIs.SellInventory then return end
    pcall(function() APIs.SellInventory:InvokeServer() end)
    sendWebhook("Sell", "Inventory sold!")
end

