local function sendWebhook(title, description)
    if not Config.kryvexWebhook or KRYVEX.WebhookURL == "" then return end
    task.spawn(function()
        pcall(function()
            local data = {
                embeds = {{
                    title = "🔴 " .. title,
                    description = description,
                    color = 0xDC2626,
                    footer = { text = "Kryvex Hub | " .. KRYVEX.Version },
                    timestamp = DateTime.now():ToIsoDate(),
                }}
            }
            HttpService:PostAsync(KRYVEX.WebhookURL, HttpService:JSONEncode(data), Enum.HttpContentType.ApplicationJson)
        end)
    end)
end

