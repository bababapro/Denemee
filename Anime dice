Boss.AutoFarmSwitch = Boss:AddSwitch("Auto Farm Boss", function(state)
    Boss.Data.Running = state
    Boss.Data.Generation += 1
    if not state then
        Boss.StatusLabel.Text = "Status: Disabled"
        return
    end
    local generation = Boss.Data.Generation
    task.spawn(function()
        local wasFighting = false
        while Boss.Data.Running and Boss.Data.Generation == generation do
            pcall(function()
                local model, health, maxHealth, hitbox = findActiveBoss()
                if model then
                    if not wasFighting then
                        wasFighting = true
                        Boss.Data.AttackSequence = nil
                        Boss.Data.EvadeUntil = 0
                        Boss.Data.DodgeStomps = false
                    end
                    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        Boss.StatusLabel.Text = "Status: Fighting"
                        attackBoss(model, health, maxHealth, hitbox)
                    else
                        Boss.StatusLabel.Text = "Status: Waiting for Respawn"
                    end
                elseif wasFighting then
                    wasFighting = false
                    pcall(function() collectChest(generation) end)
                    Boss.BossLabel.Text = "Boss: None"
                    Boss.HealthLabel.Text = "Health: 0 / 0"
                    Boss.StatusLabel.Text = "Status: Waiting for Boss"
                else
                    Boss.StatusLabel.Text = "Status: Waiting for Boss"
                end
            end)
            task.wait(wasFighting and 0.03 or 0.25)
        end
    end)
end)

