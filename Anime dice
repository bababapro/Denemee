            Stats.dice = data.Dice or "-"
            
            local now = os.clock()
            local balance = 0
            for _, slot in pairs(data.Slots) do
                balance = balance + (slot.balance or 0)
            end
            if lastBalance > 0 then
                Stats.incomePerSec = (balance - lastBalance) / (now - lastTime)
            end
            lastBalance = balance
            lastTime = now
        end)
    end
end)

